# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local example:  mongodb://localhost:27017/task-management
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/task-management
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/task-management

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# CORS (comma-separated if you need more than one allowed origin)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Admin seed credentials (used only by src/scripts/seedAdmin.js)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
